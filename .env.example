# WhatsApp Bot Configuration

# Groq API Key (Recommended for ultra-fast Llama 3.3 70B & Whisper voice transcription)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: Google Gemini API Key (Fallback if Groq is not configured)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Bot Display Name
BOT_NAME=@sam

# Command Prefix (Commands also work with @sam prefix)
COMMAND_PREFIX=!

# Group Context Memory Limit (Number of recent messages remembered per group)
CONTEXT_LIMIT=15

# Response latency simulation in milliseconds (Min and Max delays to mimic human typing)
TYPING_DELAY_MIN=1000
TYPING_DELAY_MAX=2500
